{
  "name": "@deploystack/backend",
  "version": "0.36.0",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && webpack --mode=production",
    "build:dev": "tsc && webpack --mode=development",
    "build:watch": "tsc && webpack --mode=development --watch",
    "start": "node --env-file=.env dist/index.js",
    "lint": "eslint --config eslint.config.ts 'src/**/*.ts' --fix",
    "check:no-console": "node scripts/check-no-console.js",
    "db:generate": "drizzle-kit generate",
    "db:up": "drizzle-kit up",
    "release": "release-it --config=.release-it.js",
    "test:e2e": "jest",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest --coverage",
    "api:spec": "node scripts/generate-api-spec.js",
    "api:spec:json": "curl -s http://localhost:3000/documentation/json > api-spec.json",
    "api:spec:yaml": "curl -s http://localhost:3000/documentation/yaml > api-spec.yaml"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@libsql/client": "^0.15.15",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@octokit/auth-app": "^8.0.2",
    "@octokit/request": "^10.0.3",
    "arctic": "^3.7.0",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.6",
    "fastify": "^5.6.1",
    "fastify-favicon": "^5.0.0",
    "isomorphic-dompurify": "^2.28.0",
    "lucia": "^3.2.2",
    "nanoid": "^5.1.6",
    "nodemailer": "^7.0.6",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.1",
    "pug": "^3.0.2",
    "zod": "^4.0.17",
    "zod-openapi": "^5.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.35.0",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pug": "^2.0.10",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitest/coverage-v8": "^3.2.3",
    "copy-webpack-plugin": "^13.0.1",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.36.0",
    "fs-extra": "^11.3.2",
    "jest": "^30.2.0",
    "node-loader": "^2.1.0",
    "nodemon": "^3.1.10",
    "release-it": "^19.0.5",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.3",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  }
}
