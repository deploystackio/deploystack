{
  "name": "@deploystack/backend",
  "version": "0.20.7",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "lint": "eslint --config eslint.config.ts 'src/**/*.ts' --fix",
    "check:no-console": "node scripts/check-no-console.js",
    "db:generate": "drizzle-kit generate",
    "db:up": "drizzle-kit up",
    "release": "release-it --config=.release-it.js",
    "test:e2e": "jest",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest --coverage",
    "api:spec": "node scripts/generate-api-spec.js",
    "api:spec:json": "curl -s http://localhost:3000/documentation/json > api-spec.json",
    "api:spec:yaml": "curl -s http://localhost:3000/documentation/yaml > api-spec.yaml"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@libsql/client": "^0.14.0",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@node-rs/argon2": "^2.0.2",
    "arctic": "^3.7.0",
    "argon2": "^0.43.0",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.4.0",
    "fastify-favicon": "^5.0.0",
    "lucia": "^3.2.2",
    "nodemailer": "^7.0.3",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "pug": "^3.0.2",
    "zod": "^3.25.67",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.27.0",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/nodemailer": "^6.4.14",
    "@types/pug": "^2.0.10",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.0",
    "@vitest/coverage-v8": "^3.2.3",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.29.0",
    "fs-extra": "^11.3.0",
    "jest": "^30.0.2",
    "nodemon": "^3.1.10",
    "release-it": "^19.0.2",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.3"
  },
  "overrides": {
    "glob": "^10.0.0",
    "inflight": "npm:@isaacs/inflight@^1.0.6"
  }
}
