# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Frontend Integration
# URL of your frontend application for CORS and redirects
DEPLOYSTACK_FRONTEND_URL=http://localhost:5173

# ============================================================================
# Security (Required)
# ============================================================================

# Encryption key for sensitive data (cookies, global settings, OAuth tokens)
# MUST be 32 bytes (64 hex characters)
# Generate with: openssl rand -hex 32
# IMPORTANT: Use different keys for dev/staging/prod
DEPLOYSTACK_ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Logging Configuration
# Available levels: trace, debug, info, warn, error, fatal
# Default: debug (development), info (production)
# LOG_LEVEL=debug

# Plugin System (Optional)
# Custom path for loading plugins
# PLUGINS_PATH=/path/to/custom/plugins

# PostgreSQL Database Configuration
# DeployStack uses PostgreSQL as its database backend
# For local development, you can use the provided script: npm run postgres:local
# For production, configure your PostgreSQL instance below

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=deploystack
POSTGRES_USER=deploystack
POSTGRES_PASSWORD=deploystack
POSTGRES_SSL=false

# Note: Database configuration is also managed through the setup wizard at /setup
# The database type and connection details are stored in persistent_data/db.selection.json
# Environment variables take precedence over the stored configuration

# ============================================================================
# GitHub Deployment (Configured via Global Settings)
# ============================================================================

# GitHub App credentials are configured via Admin UI → Settings → Deployment
# No environment variables needed for GitHub App!
# All credentials (app_id, client_id, client_secret, private_key, webhook_secret)
# are stored encrypted in global settings and managed through the admin interface
