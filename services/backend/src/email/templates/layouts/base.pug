//- @description Base email template layout
//- @variables title, preheader
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(http-equiv="X-UA-Compatible" content="IE=edge")
    title= title || 'DeployStack'
    if preheader
      //- Preheader text for email clients
      style.
        .preheader { display: none !important; visibility: hidden; opacity: 0; color: transparent; height: 0; width: 0; }
    style.
      /* Reset styles */
      *, *::after, *::before {
        box-sizing: border-box;
      }
      body, table, td, p, a, li, blockquote {
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
      }
      table {
        border-spacing: 0;
      }
      table, td {
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
      }
      img {
        -ms-interpolation-mode: bicubic;
        border: 0;
        height: auto;
        line-height: 100%;
        outline: none;
        text-decoration: none;
      }

      /* Base styles */
      body {
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        background: #F9F8F9;
        font-family: Inter, "SF Pro", -apple-system, BlinkMacSystemFont, ui-sans-serif, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Open Sans", "Helvetica Neue", sans-serif;
        font-size: 15px;
        line-height: 1.4;
        color: #3C4149;
        min-width: 100%;
      }

      /* Typography */
      h1, h2, h3, h4, h5, h6 {
        font-family: "Inter Display", Inter, "SF Pro", -apple-system, BlinkMacSystemFont, ui-sans-serif, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Open Sans", "Helvetica Neue", sans-serif;
      }
      h1 {
        font-size: 24px;
        line-height: 1.2;
        font-weight: 700;
        margin-top: 0;
        margin-bottom: 24px;
        color: #282A30;
      }
      h2 {
        font-size: 20px;
        line-height: 1.3;
        font-weight: 600;
        margin-top: 24px;
        margin-bottom: 16px;
        color: #282A30;
      }
      p {
        margin-top: 0;
        margin-bottom: 16px;
        font-size: 15px;
        line-height: 1.4;
        color: #3C4149;
      }
      p > strong {
        color: #282A30;
      }
      p:last-child {
        margin-bottom: 0;
      }
      ul, ol {
        margin-top: 16px;
        margin-bottom: 16px;
        padding-left: 16px;
      }
      ul li, ol li {
        margin-top: 6px;
        margin-left: 0;
      }
      a {
        color: #6666FF;
        text-decoration: none;
      }

      /* Section dividers */
      hr {
        display: inline-block;
        background: #EFF1F4;
        margin-top: 24px;
        width: 42px;
        min-height: 1px;
        border: none;
      }

      /* Buttons */
      .button {
        display: inline-block;
        padding: 12px 16px;
        color: #ffffff !important;
        background: #5E6AD2;
        border-radius: 5px;
        font-size: 13px;
        line-height: 1.2;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        margin-top: 8px;
        margin-bottom: 24px;
      }
      .button:hover {
        background: #4E5AC2;
      }

      /* Content card */
      .content-card {
        border: 1px solid #EFF1F4;
        border-radius: 5px;
        padding: 32px 28px 24px 28px;
        background: #ffffff;
        color: #3C4149;
      }

      /* Link styling */
      .section-link {
        font-size: 15px;
        font-weight: 500;
        line-height: 24px;
        padding: 0px 16px 20px 0px;
      }

      /* Utility classes */
      .text-center { text-align: center; }
      .text-muted { color: #6b7280; }

      /* Responsive */
      @media only screen and (max-width: 600px) {
        .content-card {
          padding: 24px 20px !important;
        }
        h1 {
          font-size: 20px !important;
        }
        .button {
          display: block !important;
          width: 100% !important;
          text-align: center !important;
        }
      }

  body
    if preheader
      span(style="display: none !important; color: #F9F8F9; margin: 0; padding: 0; font-size: 1px; line-height: 1px")= preheader

    table(bgcolor="#F9F8F9" width="100%" style="width: 100% !important; background: #F9F8F9; margin: 0; padding: 0; min-width: 100%")
      tr
        td(align="center")
          include header.pug

          table(width="602" style="width: 602px; margin: 24px" border="0" cellspacing="0" cellpadding="0")
            tr
              td(align="left")
                table(width="100%" class="content-card" border="0" cellspacing="0" cellpadding="0")
                  tr
                    td
                      block content

          include footer.pug
