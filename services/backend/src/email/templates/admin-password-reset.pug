//- @description Admin-initiated password reset email template
//- @variables userName, userEmail, resetUrl, expirationTime, supportEmail
extends layouts/base.pug

block content
  h1 Password Reset Initiated by Administrator
  
  p Hello #{userName},
  
  p An administrator has initiated a password reset for your account (#{userEmail}). If you were expecting this action, you can reset your password using the link below.
  
  .text-center
    a.button(href=resetUrl style="display: inline-block; padding: 12px 24px; background-color: #007bff; color: white; text-decoration: none; border-radius: 4px; font-weight: bold; margin: 20px 0;") Reset Your Password
  
  p 
    strong Important security information:
  ul
    li This password reset was initiated by a system administrator
    li The reset link will expire in #{expirationTime}
    li After resetting your password, you will need to log in again on all devices
    li If you did not expect this password reset, please contact your administrator immediately
  
  p If the button above doesn't work, you can copy and paste this link into your browser:
  p.link-text(style="word-break: break-all; color: #007bff;") #{resetUrl}
  
  hr(style="margin: 30px 0; border: none; border-top: 1px solid #eee;")
  
  p.small-text(style="font-size: 12px; color: #666;") 
    | If you have any questions about this password reset, please contact 
    if supportEmail
      a(href=`mailto:${supportEmail}`) #{supportEmail}
    else
      | your system administrator
    | .
  
  p.small-text(style="font-size: 12px; color: #666;") 
    | This email was sent because an administrator initiated a password reset for your account. 
    | If you believe this was sent in error, please contact your administrator immediately.