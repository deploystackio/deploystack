{
  "name": "@deploystack/gateway",
  "version": "0.2.0",
  "description": "The local DeployStack Gateway for secure MCP server management.",
  "main": "dist/index.js",
  "bin": {
    "deploystack": "bin/gateway.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "link": "npm run build && npm link",
    "release": "release-it --config=.release-it.js",
    "lint": "eslint --config eslint.config.ts 'src/**/*.ts' --fix",
    "test:unit": "echo 'Tests not implemented yet'"
  },
  "keywords": [
    "mcp",
    "gateway",
    "deploystack"
  ],
  "author": "DeployStack",
  "license": "SEE LICENSE IN ../../LICENSE",
  "dependencies": {
    "commander": "^12.0.0",
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "@release-it/conventional-changelog": "^10.0.1",
    "release-it": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.31.0",
    "typescript-eslint": "^8.38.0"
  }
}
