{
  "name": "@deploystack/gateway",
  "version": "0.12.0",
  "description": "The local DeployStack Gateway for secure MCP server management.",
  "main": "dist/index.js",
  "bin": {
    "deploystack": "bin/gateway.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "link": "npm run build && npm link",
    "release": "release-it --config=.release-it.js",
    "lint": "eslint --config eslint.config.ts 'src/**/*.ts' --fix",
    "test:unit": "echo 'Tests not implemented yet'"
  },
  "keywords": [
    "mcp",
    "gateway",
    "deploystack"
  ],
  "author": "DeployStack",
  "license": "SEE LICENSE IN ../../LICENSE",
  "dependencies": {
    "commander": "^14.0.0",
    "chalk": "^5.6.0",
    "@zowe/secrets-for-zowe-sdk": "^8.0.0",
    "open": "^10.2.0",
    "ora": "^8.2.0",
    "inquirer": "^12.9.4",
    "node-fetch": "^3.3.0",
    "cli-table3": "^0.6.3",
    "fastify": "^5.1.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "uuid": "^11.1.0",
    "fs-extra": "^11.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/uuid": "^10.0.0",
    "@types/fs-extra": "^11.0.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2",
    "@release-it/conventional-changelog": "^10.0.1",
    "release-it": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^9.34.0",
    "typescript-eslint": "^8.38.0"
  }
}
