# DeployStack Satellite Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# Backend Connection Configuration
DEPLOYSTACK_BACKEND_URL=http://localhost:3000

# Backend Polling Configuration
DEPLOYSTACK_BACKEND_POLLING_INTERVAL=60

# Satellite Registration Configuration (MANDATORY)
DEPLOYSTACK_SATELLITE_NAME=dev-satellite-001

# Status Display Configuration (optional)
DEPLOYSTACK_STATUS_SHOW_UPTIME=true
DEPLOYSTACK_STATUS_SHOW_VERSION=true

# Future authentication (not used yet)
# SATELLITE_API_KEY=your_api_key_here
