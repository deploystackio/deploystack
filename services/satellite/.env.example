# DeployStack Satellite Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# Backend Connection Configuration
DEPLOYSTACK_BACKEND_URL=http://localhost:3000

# Backend Public URL for OAuth (optional)
# Use when satellite connects to backend via private network but MCP clients
# need to reach backend via public internet URL.
#
# Example split-network setup:
# - DEPLOYSTACK_BACKEND_URL=http://10.0.0.3:8080 (internal/private network)
# - DEPLOYSTACK_BACKEND_PUBLIC_URL=https://cloud.deploystack.io (external/public)
#
# If not set, defaults to DEPLOYSTACK_BACKEND_URL (works for simple deployments)
DEPLOYSTACK_BACKEND_PUBLIC_URL=

# Satellite Public URL Configuration (REQUIRED for production OAuth)
# This is the publicly accessible URL of this satellite instance
# Used for:
# 1. Backend registration and heartbeat for satellite discovery
# 2. OAuth 2.0 Protected Resource Metadata (RFC 9728)
#    - Resource identifier: ${DEPLOYSTACK_SATELLITE_URL}/mcp (RFC 8707 audience binding)
#
# Behavior:
# - If set: Sent to backend during registration and first heartbeat for satellite discovery
# - If not set: Backend auto-detects URL from request headers (X-Forwarded-Proto, X-Forwarded-Host)
#
# Development: Leave blank (auto-detection works for http://localhost:PORT)
# Production: Set to your satellite's public URL without path suffix
#
# Examples:
# - Production global satellite: https://satellite.deploystack.io
# - Production team satellite: https://satellite-team1.example.com
# - Development: (leave blank or comment out for auto-detection)
#
# IMPORTANT: Do NOT include /mcp or /sse paths - use base URL only
# OAuth resource identifier is automatically constructed as ${DEPLOYSTACK_SATELLITE_URL}/mcp
#
DEPLOYSTACK_SATELLITE_URL=

# OAuth Resource Documentation URL (optional)
# URL displayed in RFC 9728 Protected Resource Metadata
# Points MCP clients to satellite documentation
#
# Default: https://docs.deploystack.io/
DEPLOYSTACK_RESOURCE_DOCUMENTATION=

# Backend Polling Configuration
DEPLOYSTACK_BACKEND_POLLING_INTERVAL=60

# Satellite Registration Configuration (MANDATORY)
DEPLOYSTACK_SATELLITE_NAME=dev-satellite-001

# Registration Token (REQUIRED for satellite pairing)
# SECURITY: This token is required for all new satellite registrations
# 
# How to obtain a registration token:
# 1. Login to https://cloud.deploystack.io as admin
# 2. Go to Admin → Satellites → Pairing (for global satellites)
# 3. Or go to Team Settings → Satellites → Pairing (for team satellites)
# 4. Click "Generate Token" and copy the full token
#
# Token formats:
# - Global tokens: deploystack_satellite_global_eyJhbGciOi...
# - Team tokens: deploystack_satellite_team_eyJhbGciOi...
#
# Token expiration:
# - Global tokens: 1 hour
# - Team tokens: 24 hours
# - Tokens are single-use (consumed during registration)
#
DEPLOYSTACK_REGISTRATION_TOKEN=

# Status Display Configuration (optional)
DEPLOYSTACK_STATUS_SHOW_UPTIME=true
DEPLOYSTACK_STATUS_SHOW_VERSION=true

# Debug Endpoint Configuration (optional)
# WARNING: This exposes detailed MCP server information including:
# - All running processes with PIDs
# - Configuration details
# - Tool discovery information
# - Team isolation details
# Recommended: Set to false in production environments
DEPLOYSTACK_STATUS_SHOW_MCP_DEBUG_ROUTE=true

# Event Bus Configuration (optional)
# Batch interval in milliseconds (default: 3000 = 3 seconds)
EVENT_BATCH_INTERVAL_MS=3000

# Maximum events per batch (default: 100)
EVENT_MAX_BATCH_SIZE=100

# Maximum events in queue (default: 10000)
EVENT_MAX_QUEUE_SIZE=10000

# Graceful shutdown flush timeout in milliseconds (default: 5000 = 5 seconds)
EVENT_FLUSH_TIMEOUT_MS=5000

# nsjail Resource Limits (Production Linux only)
# These limits apply to each MCP server process when running with nsjail isolation
# Only active when NODE_ENV=production and platform is Linux
#
# Defaults based on empirical testing with npx and Node.js V8:
# - 2048MB memory: Absolute minimum for V8 initialization (cannot be reduced)
# - 1000 processes: npm spawns many child processes during package installation
# - 1024 file descriptors: Adequate for file I/O operations
# - 50MB file size: Prevents oversized downloads while accommodating 99% of npm packages
# - 100MB tmpfs: Sufficient for npm cache and temporary operations

# Memory limit per process in MB (default: 2048, V8 minimum requirement)
NSJAIL_MEMORY_LIMIT_MB=2048

# CPU time limit per process in seconds (default: 60)
NSJAIL_CPU_TIME_LIMIT_SECONDS=60

# Maximum number of processes per MCP server (default: 1000, required for npm)
NSJAIL_MAX_PROCESSES=1000

# Maximum number of open file descriptors (default: 1024)
NSJAIL_RLIMIT_NOFILE=1024

# Maximum file size in MB (default: 50, prevents oversized npm downloads)
NSJAIL_RLIMIT_FSIZE=50

# Tmpfs size for /tmp directory (default: 100M, sufficient for npm cache)
NSJAIL_TMPFS_SIZE=100M

# GitHub Deployment tmpfs Configuration
# Tmpfs quota for GitHub deployment working directories (default: 300M)
# This is a kernel-enforced hard limit for npm install/pip install during deployment
# If dependencies exceed this size, the process is killed immediately
NSJAIL_DEPLOYMENT_TMPFS_SIZE=300M

# Base directory for GitHub deployment tmpfs mounts (default: /opt/mcp-deployments)
# Each deployment gets a subdirectory: {base}/{team-id}/{installation-id}
MCP_DEPLOYMENT_BASE_DIR=/opt/mcp-deployments

# Enable tmpfs in development mode (default: false)
# By default, tmpfs is only used in production (NODE_ENV=production)
# Set to 'true' to test tmpfs behavior in development
MCP_USE_TMPFS=false

# Process Idle Timeout (stdio MCP servers only)
# Idle stdio processes are automatically terminated after this duration to save resources
# Processes are transparently respawned when API calls arrive (1-3s latency)
# Set to 0 to disable idle timeout (processes never sleep)
# Default: 180 seconds (3 minutes)
MCP_PROCESS_IDLE_TIMEOUT_SECONDS=180

# Runtime Validation (optional)
# Set to 'true' to skip system runtime checks at startup (Node.js, Python)
# By default, satellite validates that required runtimes are installed before starting
# Useful for CI/CD pipelines or Docker builds where runtimes are guaranteed
# Default: false (validates Node.js and Python 3 availability)
DEPLOYSTACK_SKIP_RUNTIME_CHECKS=false

# Log Rate Limiting (per-process protection against stderr flooding)
# Prevents malicious or buggy MCP servers from exhausting satellite resources
# and overloading backend database with excessive log entries
#
# Maximum logs per second per MCP process (default: 20)
# Excess logs are dropped silently with periodic warning summaries
LOG_RATE_LIMIT_PER_SECOND=20

# Maximum log line length in bytes (default: 1024 = 1KB)
# Lines exceeding this length are truncated with "... [truncated]" suffix
LOG_MAX_LINE_LENGTH_BYTES=1024

# Warning interval in milliseconds (default: 60000 = 1 minute)
# How often to emit warnings when rate limit is exceeded
LOG_RATE_LIMIT_WARNING_INTERVAL_MS=60000
